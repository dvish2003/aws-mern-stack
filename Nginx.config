server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
  location /api/ {
      rewrite ^/api/(.*)$ /api/$1 break;
      proxy_pass http://localhost:5000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 }




server {
    listen 80;  # Listen on HTTP port 80 for incoming web traffic
    server_name _;  # Default server block, used if no specific domain matches

    # ===== Frontend Routing =====
    location / {
        proxy_pass http://localhost:3000;  #Forward requests to the frontend app running on port 3000 (React/Next.js)
        proxy_http_version 1.1;  # Use HTTP/1.1 protocol (needed for WebSocket support)
        proxy_set_header Upgrade $http_upgrade;  # Preserve the WebSocket upgrade header
        proxy_set_header Connection "upgrade";  #  Preserve the WebSocket connection header
        proxy_set_header Host $host;  # Forward the original Host header to the backend
        proxy_cache_bypass $http_upgrade;  #Bypass caching for WebSocket upgrade requests
    }

    # ===== Backend API Routing =====
    location /api/ {
        rewrite ^/api/(.*)$ /api/$1 break;  #Preserve the /api/... path when forwarding to the backend
        proxy_pass http://localhost:5000;  #Forward API requests to the backend running on port 5000 (Node.js/Express)
        proxy_http_version 1.1;  # Use HTTP/1.1 protocol (supports WebSocket/long-polling)
        proxy_set_header Host $host;  #Preserve the original Host header
        proxy_set_header X-Real-IP $remote_addr;  #Forward the real client IP to the backend
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  #Preserve original client IP through multiple proxies
    }
}
